Options -MultiViews

# Achado do líder, 22/09/2026: mod_dir do Apache acrescenta barra final por
# redirecionamento (301) sempre que o caminho pedido bate um diretório
# físico no servidor, mesmo sem listagem habilitada. Isso incluía /busca,
# porque em algum momento existiu um diretório com esse nome no destino
# (o índice de busca antes ficava em dist/busca/). Desligado aqui para
# nenhuma rota da SPA correr esse risco, agora ou no futuro.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

RewriteEngine On
RewriteBase /
# Lista explícita das pastas que este pacote realmente serve direto (hoje
# assets/ e icones/), mais robusta que a condição genérica de diretório
# ("-d", qualquer pasta que exista no disco do servidor):
# scripts/verificar-htaccess-pastas.ts confere que esta lista bate com as
# pastas reais de todo build, e reprova se divergir.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_URI} ^/(assets|icones)(/|$)
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
