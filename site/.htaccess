# Caderno de Direito - configuração do servidor para a pasta publicada.
# Cada bloco é condicional ao módulo Apache existir no servidor
# compartilhado, para nunca derrubar o site por módulo ausente.

# Não indexar (decisão do líder, 21/09/2026): o cabeçalho cobre também os
# arquivos que não são HTML. Não há Disallow em robots.txt de propósito,
# para o rastreador conseguir ler esta marcação (ver docs/publicacao.md).
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Página de erro 404 própria do site.
ErrorDocument 404 /404.html

# Compressão de texto, quando o módulo existir.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
  </IfModule>
</IfModule>

# Tipo de conteúdo correto para os arquivos servidos aqui.
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddType text/html .html
</IfModule>

# Cache: longo para CSS e fontes (versionam por nome quando mudam), curto
# para HTML (para que uma atualização de conteúdo apareça logo).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>
