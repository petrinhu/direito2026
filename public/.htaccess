# Webroot sem conteúdo: o app mora fora daqui e só sai por api/portao.php.
Options -MultiViews -Indexes
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

RewriteEngine On
RewriteBase /
# Porta única: o caminho pelo domínio-pai é recusado (medido aberto em 06/11/2026).
RewriteCond %{HTTP_HOST} !^direito2026\.drpetrus\.top$ [NC]
RewriteRule ^ - [F,L]
RewriteRule ^api/nucleo(/|$) - [F,L]
# Únicos caminhos servidos sem portão: endpoints e o visual da tela de entrada (com as duas fontes dela).
RewriteRule ^api/[a-z0-9/-]+\.php$ - [L]
RewriteRule ^(sw\.js|robots\.txt|entrada\.css|icones/favicon\.svg|fontes/inter-400\.woff2|fontes/cormorant-garamond-700\.woff2)$ - [L]
RewriteRule ^api(/|$) - [R=404,L]
# Todo o resto passa pelo portão.
RewriteRule ^ api/portao.php [L]

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  # Revalida por ETag em toda visita: o CSS e as fontes da entrada têm nome fixo (o endereço do CSS
  # leva ?v=, mas as fontes não). Sem isso, uma correção fica presa no cache do navegador.
  <FilesMatch "^(entrada\.css|inter-400\.woff2|cormorant-garamond-700\.woff2)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
