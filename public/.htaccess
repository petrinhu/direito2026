Options -MultiViews
RewriteEngine On
RewriteBase /
# Achado do líder, 22/09/2026, medido no site publicado: a condição
# genérica de diretório ("-d", qualquer pasta que exista no disco do
# servidor) deixava passar direto pastas SOBRANDO de um envio anterior
# (a publicação sobrepõe, não limpa; ver docs/publicacao.md). Uma pasta
# órfã com o mesmo nome do primeiro segmento de uma rota da SPA volta a
# sequestrar a rota, mesmo depois de o pacote novo não ter mais aquela
# pasta. Troca: lista explícita das pastas que ESTE pacote realmente
# serve direto (hoje assets/ e icones/), nunca "qualquer diretório
# existente". scripts/verificar-htaccess-pastas.ts confere que esta
# lista bate com as pastas reais de todo build, e reprova se divergir.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_URI} ^/(assets|icones)(/|$)
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
